# Backend
PORT=3000
NODE_ENV=development

# PostgreSQL local do UniCore.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=unicore
DB_USER=postgres
DB_PASSWORD=SUA_SENHA
DATABASE_POOL_MAX=10

# Alternativa: use DATABASE_URL em vez das variáveis DB_*.
# DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5433/unicore

# Keep this secret only on the backend.
JWT_SECRET=change-me-in-a-real-environment

# Allowed browser origin when the Angular dev server is used without its proxy.
CORS_ORIGIN=http://localhost:4200
