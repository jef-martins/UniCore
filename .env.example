# Backend
PORT=3000
NODE_ENV=development

# Prisma/PostgreSQL local do UniCore.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5433/unicore

# Usadas pelo fallback de configuração do backend.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=unicore
DB_USER=postgres
DB_PASSWORD=SUA_SENHA
DATABASE_POOL_MAX=10

# Senha temporária apenas para o seed inicial local.
SEED_DEFAULT_PASSWORD=SUA_SENHA_INICIAL

# Segredo somente no backend.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=9h
CORS_ORIGIN=http://localhost:4200

# Google Workspace / Classroom
# Opção A (OAuth 2.0 - Recomendada):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/classroom/google/callback
GOOGLE_REFRESH_TOKEN=

# Opção B (Conta de Serviço com Domain-Wide Delegation):
# Preferencialmente, use uma chave de conta de serviço armazenada fora do projeto.
GOOGLE_SERVICE_ACCOUNT_FILE=/caminho/privado/google-service-account.json
# Necessário quando a conta de serviço usa Domain-Wide Delegation.
GOOGLE_ADMIN_SUBJECT=administrador@exemplo.edu.br
# Alternativa apenas para ambientes que não podem usar um arquivo privado.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Integrações externas de leitura. Crie usuários MySQL com permissão SELECT apenas.
DB_HOST_UNIMESTRE=servidor-unimestre.exemplo.edu.br
DB_PORT_UNIMESTRE=3306
DB_NAME_UNIMESTRE=nome_do_banco
DB_USER_UNIMESTRE=usuario_somente_leitura
DB_PASS_UNIMESTRE=senha_forte
DB_HOST_FAIP=servidor-faip.exemplo.edu.br
DB_PORT_FAIP=3306
DB_NAME_FAIP=nome_do_banco
DB_USER_FAIP=usuario_somente_leitura
DB_PASS_FAIP=senha_forte
