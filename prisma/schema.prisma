generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessRole {
  VESTIBULAR
  ADMIN
  MASTER
  TESOURARIA
  SECRETARIA
  COORDENACAO
  REGISTRO_ACADEMICO
  ALUNO
  PROFESSOR
}

enum TaskType {
  VESTIBULAR
  ADMINISTRACAO
  TESOURARIA
  COORDENACAO
  REGISTRO_ACADEMICO
  ALUNOS
  PROFESSORES
}

enum ClassroomRoomStatus {
  PENDING
  PROCESSING
  CREATED
  CREATED_WITH_WARNINGS
  FAILED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         AccessRole
  isActive            Boolean           @default(true) @map("is_active")
  emailVerified       Boolean           @default(false) @map("email_verified")
  verificationToken   String?           @unique @map("verification_token")
  verificationExpires DateTime?         @map("verification_expires")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  assignedTasks Task[]            @relation("AssignedTasks")
  createdTasks  Task[]            @relation("CreatedTasks")
  reservations  ItemReservation[]

  @@map("users")
}

model Task {
  id                           String      @id @default(uuid()) @db.Uuid
  title                        String
  description                  String?
  date                         DateTime    @db.Date
  type                         TaskType
  sector                       AccessRole?
  completed                    Boolean     @default(false)
  isPriority                   Boolean     @default(false) @map("is_priority")
  createdAt                    DateTime    @default(now()) @map("created_at")
  completedAt                  DateTime?   @map("completed_at")
  updatedAt                    DateTime    @updatedAt @map("updated_at")
  userId                       String?     @map("user_id") @db.Uuid
  user                         User?       @relation("AssignedTasks", fields: [userId], references: [id], onDelete: SetNull)
  createdById                  String?     @map("created_by_id") @db.Uuid
  createdBy                    User?       @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  attachmentName               String?     @map("attachment_name")
  attachmentPath               String?     @map("attachment_path")
  attachmentSize               Int?        @map("attachment_size")
  attachmentMimeType           String?     @map("attachment_mime_type")
  completionNotes              String?     @map("completion_notes")
  completionAttachmentName     String?     @map("completion_attachment_name")
  completionAttachmentPath     String?     @map("completion_attachment_path")
  completionAttachmentSize     Int?        @map("completion_attachment_size")
  completionAttachmentMimeType String?     @map("completion_attachment_mime_type")

  @@index([userId, date])
  @@index([sector, date])
  @@map("tasks")
}

model ClassroomRoom {
  id               String              @id @default(uuid()) @db.Uuid
  academicCourseId String              @map("academic_course_id")
  subjectId        String              @map("subject_id")
  classGroup       String              @map("class_group")
  semester         String
  subjectName      String              @map("subject_name")
  teacherEmail     String              @map("teacher_email")
  googleCourseId   String?             @unique @map("google_course_id")
  alternateLink    String?             @map("alternate_link")
  status           ClassroomRoomStatus @default(PENDING)
  lastMessage      String?             @map("last_message")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([academicCourseId, subjectId, classGroup, semester])
  @@index([semester, academicCourseId])
  @@map("classroom_rooms")
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  MAINTENANCE
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ItemCondition {
  PERFEITO
  COM_AVARIAS
  DEFEITO_FUNCIONA
  DEFEITO_PARCIAL
  NAO_FUNCIONA
}

model ReservableItem {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  category     String
  code         String            @unique
  location     String
  description  String?
  status       ItemStatus        @default(AVAILABLE)
  condition    ItemCondition     @default(PERFEITO)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  reservations ItemReservation[]

  @@map("reservable_items")
}

model ItemReservation {
  id            String            @id @default(uuid()) @db.Uuid
  itemId        String            @map("item_id") @db.Uuid
  item          ReservableItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String?           @map("user_id") @db.Uuid
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  requesterName String            @map("requester_name")
  department    String
  startDate     DateTime          @map("start_date")
  endDate       DateTime          @map("end_date")
  purpose       String
  notes         String?
  status        ReservationStatus @default(ACTIVE)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([itemId, startDate, endDate])
  @@map("item_reservations")
}
