generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessRole {
  VESTIBULAR
  ADMIN
  MASTER
  TESOURARIA
  SECRETARIA
  COORDENACAO
  REGISTRO_ACADEMICO
  ALUNO
  PROFESSOR
}

enum TaskType {
  VESTIBULAR
  ADMINISTRACAO
  TESOURARIA
  COORDENACAO
  REGISTRO_ACADEMICO
  ALUNOS
  PROFESSORES
}

enum ClassroomRoomStatus {
  PENDING
  PROCESSING
  CREATED
  CREATED_WITH_WARNINGS
  FAILED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         AccessRole
  isActive            Boolean           @default(true) @map("is_active")
  emailVerified       Boolean           @default(false) @map("email_verified")
  verificationToken   String?           @unique @map("verification_token")
  verificationExpires DateTime?         @map("verification_expires")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  assignedTasks Task[]            @relation("AssignedTasks")
  createdTasks  Task[]            @relation("CreatedTasks")
  reservations  ItemReservation[]
  evaluations   ItemEvaluation[]
  coordinatedCourses AcademicCourseSetting[]
  issuedCertificates CertificateEmissionLog[]
  createdEvents      CertificateEvent[]
  participatedEvents CertificateParticipant[]
  registeredLeads    Lead[]                    @relation("RegisteredLeads")

  @@map("users")
}

model Task {
  id                           String      @id @default(uuid()) @db.Uuid
  title                        String
  description                  String?
  date                         DateTime    @db.Date
  type                         TaskType
  sector                       AccessRole?
  completed                    Boolean     @default(false)
  isPriority                   Boolean     @default(false) @map("is_priority")
  createdAt                    DateTime    @default(now()) @map("created_at")
  completedAt                  DateTime?   @map("completed_at")
  updatedAt                    DateTime    @updatedAt @map("updated_at")
  userId                       String?     @map("user_id") @db.Uuid
  user                         User?       @relation("AssignedTasks", fields: [userId], references: [id], onDelete: SetNull)
  createdById                  String?     @map("created_by_id") @db.Uuid
  createdBy                    User?       @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  attachmentName               String?     @map("attachment_name")
  attachmentPath               String?     @map("attachment_path")
  attachmentSize               Int?        @map("attachment_size")
  attachmentMimeType           String?     @map("attachment_mime_type")
  completionNotes              String?     @map("completion_notes")
  completionAttachmentName     String?     @map("completion_attachment_name")
  completionAttachmentPath     String?     @map("completion_attachment_path")
  completionAttachmentSize     Int?        @map("completion_attachment_size")
  completionAttachmentMimeType String?     @map("completion_attachment_mime_type")

  @@index([userId, date])
  @@index([sector, date])
  @@map("tasks")
}

model ClassroomRoom {
  id               String              @id @default(uuid()) @db.Uuid
  academicCourseId String              @map("academic_course_id")
  subjectId        String              @map("subject_id")
  classGroup       String              @map("class_group")
  semester         String
  subjectName      String              @map("subject_name")
  teacherEmail     String              @map("teacher_email")
  googleCourseId   String?             @unique @map("google_course_id")
  alternateLink    String?             @map("alternate_link")
  status           ClassroomRoomStatus @default(PENDING)
  lastMessage      String?             @map("last_message")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([academicCourseId, subjectId, classGroup, semester])
  @@index([semester, academicCourseId])
  @@map("classroom_rooms")
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  MAINTENANCE
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ItemCondition {
  PERFEITO
  COM_AVARIAS
  DEFEITO_FUNCIONA
  DEFEITO_PARCIAL
  NAO_FUNCIONA
}

enum MaintenanceType {
  PREVENTIVA
  CORRETIVA
}

enum MaintenanceStatus {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum ItemOperationalStatus {
  FUNCIONANDO_PERFEITAMENTE
  FUNCIONANDO_COM_DEFEITOS
  COM_AVARIAS_FUNCIONANDO
  NAO_FUNCIONANDO
}

model ReservableItem {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  category     String
  code         String            @unique
  location     String
  description  String?
  status       ItemStatus        @default(AVAILABLE)
  condition    ItemCondition     @default(PERFEITO)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  reservations ItemReservation[]
  maintenances ItemMaintenance[]
  evaluations  ItemEvaluation[]

  @@map("reservable_items")
}

model ItemReservation {
  id            String            @id @default(uuid()) @db.Uuid
  itemId        String            @map("item_id") @db.Uuid
  item          ReservableItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String?           @map("user_id") @db.Uuid
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  requesterName String            @map("requester_name")
  department    String
  startDate     DateTime          @map("start_date")
  endDate       DateTime          @map("end_date")
  purpose       String
  notes         String?
  status        ReservationStatus @default(ACTIVE)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([itemId, startDate, endDate])
  @@map("item_reservations")
}

model AcademicCourseCache {
  id        String
  name      String
  semester  String
  offered   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([id, semester])
  @@index([semester])
  @@map("academic_course_cache")
}

model AcademicClassCache {
  id                     String   @id @default(uuid()) @db.Uuid
  semester               String
  academicCourseId       String   @map("academic_course_id")
  classGroup             String   @map("class_group")
  subjectId              String   @map("subject_id")
  subjectName            String   @map("subject_name")
  teacherId              String?  @map("teacher_id")
  teacherName            String?  @map("teacher_name")
  teacherEmail           String?  @map("teacher_email")
  studentCount           Int      @default(0) @map("student_count")
  classroomAlternateLink String?  @map("classroom_alternate_link")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([semester, academicCourseId, classGroup, subjectId])
  @@index([semester, academicCourseId])
  @@map("academic_class_cache")
}

model AcademicStudentCache {
  id               String   @id @default(uuid()) @db.Uuid
  semester         String
  academicCourseId String   @map("academic_course_id")
  subjectId        String   @map("subject_id")
  classGroup       String   @map("class_group")
  studentId        String   @map("student_id")
  name             String
  email            String?
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([semester, academicCourseId, subjectId, classGroup, studentId])
  @@index([semester, academicCourseId, subjectId, classGroup])
  @@map("academic_student_cache")
}

model GoogleCourseCache {
  id                 String   @id
  name               String
  section            String?
  descriptionHeading String?  @map("description_heading")
  alternateLink      String?  @map("alternate_link")
  courseState        String?  @map("course_state")
  teachers           Json?
  students           Json?
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("google_course_cache")
}

model AcademicCourseSetting {
  academicCourseId  String   @id @map("academic_course_id")
  courseName        String   @map("course_name")
  courseEmail       String?  @map("course_email")
  coordinatorEmail  String?  @map("coordinator_email")
  coordinatorUserId String?  @map("coordinator_user_id") @db.Uuid
  coordinatorUser   User?    @relation(fields: [coordinatorUserId], references: [id], onDelete: SetNull)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("academic_course_settings")
}

model ItemMaintenance {
  id            String            @id @default(uuid()) @db.Uuid
  itemId        String            @map("item_id") @db.Uuid
  item          ReservableItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          MaintenanceType
  status        MaintenanceStatus @default(AGENDADA)
  title         String
  description   String?
  technician    String?
  scheduledDate DateTime          @map("scheduled_date")
  completedDate DateTime?         @map("completed_date")
  cost          Decimal?          @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([itemId])
  @@map("item_maintenances")
}

model ItemEvaluation {
  id                String                @id @default(uuid()) @db.Uuid
  itemId            String                @map("item_id") @db.Uuid
  item              ReservableItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId            String?               @map("user_id") @db.Uuid
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentName       String                @map("student_name")
  rating            Int
  operationalStatus ItemOperationalStatus @map("operational_status")
  description       String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([itemId])
  @@index([userId])
  @@map("item_evaluations")
}

model CertificateEmissionLog {
  id               String   @id @default(uuid()) @db.Uuid
  inscricaoId      String   @map("inscricao_id")
  studentRa        String   @map("student_ra")
  studentName      String   @map("student_name")
  eventTitle       String   @map("event_title")
  workloadHours    Int      @map("workload_hours")
  verificationCode String   @unique @map("verification_code")
  issuedByUserId   String?  @map("issued_by_user_id") @db.Uuid
  issuedByUser     User?    @relation(fields: [issuedByUserId], references: [id], onDelete: SetNull)
  issuedAt         DateTime @default(now()) @map("issued_at")

  @@index([inscricaoId])
  @@index([studentRa])
  @@index([issuedByUserId])
  @@map("certificate_emission_logs")
}

model CertificateEvent {
  id            String                   @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  workloadHours Int                      @default(20) @map("workload_hours")
  speaker       String?
  courseName    String?                  @map("course_name")
  startDate     DateTime                 @map("start_date")
  endDate       DateTime?                @map("end_date")
  location               String?
  isActive               Boolean                  @default(true) @map("is_active")
  logoUrl                String?                  @map("logo_url")
  certificateTemplateUrl String?                  @map("certificate_template_url")
  templateStyle          Json?                    @map("template_style")
  createdById            String?                  @map("created_by_id") @db.Uuid
  createdBy              User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants           CertificateParticipant[]
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([createdById])
  @@map("certificate_events")
}

model CertificateParticipant {
  id              String           @id @default(uuid()) @db.Uuid
  eventId         String           @map("event_id") @db.Uuid
  event           CertificateEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentName     String           @map("student_name")
  studentRa       String           @map("student_ra")
  studentCpf      String?          @map("student_cpf")
  studentEmail    String?          @map("student_email")
  userId          String?          @map("user_id") @db.Uuid
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  isPaid          Boolean          @default(false) @map("is_paid")
  paymentDate     DateTime?        @map("payment_date")
  hasAttendance   Boolean          @default(true) @map("has_attendance")
  attendanceCount Int              @default(1) @map("attendance_count")
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([eventId, studentRa])
  @@index([eventId])
  @@index([studentRa])
  @@index([userId])
  @@map("certificate_participants")
}

enum LeadStatus {
  FALHOU
  LEAD
  INSCRICAO
  MATRICULA
}

model Territory {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  code           String?        @unique
  description    String?
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  subterritories Subterritory[]

  @@map("territories")
}

model Subterritory {
  id            String         @id @default(uuid()) @db.Uuid
  territoryId   String         @map("territory_id") @db.Uuid
  territory     Territory      @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  neighborhoods Neighborhood[]

  @@index([territoryId])
  @@map("subterritories")
}

model Neighborhood {
  id             String       @id @default(uuid()) @db.Uuid
  subterritoryId String       @map("subterritory_id") @db.Uuid
  subterritory   Subterritory @relation(fields: [subterritoryId], references: [id], onDelete: Cascade)
  name           String
  city           String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  streets        Street[]

  @@index([subterritoryId])
  @@map("neighborhoods")
}

model Street {
  id             String            @id @default(uuid()) @db.Uuid
  neighborhoodId String            @map("neighborhood_id") @db.Uuid
  neighborhood   Neighborhood      @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  name           String
  zipCode        String?           @map("zip_code")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  residences     ResidenceNumber[]

  @@index([neighborhoodId])
  @@map("streets")
}

model ResidenceNumber {
  id          String   @id @default(uuid()) @db.Uuid
  streetId    String   @map("street_id") @db.Uuid
  street      Street   @relation(fields: [streetId], references: [id], onDelete: Cascade)
  number      String
  complement  String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  leads       Lead[]

  @@index([streetId])
  @@map("residence_numbers")
}

model Lead {
  id                String          @id @default(uuid()) @db.Uuid
  residenceNumberId String          @map("residence_number_id") @db.Uuid
  residenceNumber   ResidenceNumber @relation(fields: [residenceNumberId], references: [id], onDelete: Cascade)
  name              String
  whatsapp          String
  courseOrArea      String          @map("course_or_area")
  date              DateTime        @db.Date
  origin            String          @default("VISITA_DOMICILIAR")
  authorizedInfo    Boolean         @default(false) @map("authorized_info")
  status            LeadStatus      @default(LEAD)
  observations      String?
  createdById       String?         @map("created_by_id") @db.Uuid
  createdBy         User?           @relation("RegisteredLeads", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([residenceNumberId])
  @@index([status])
  @@index([date])
  @@index([origin])
  @@index([createdById])
  @@map("leads")
}


